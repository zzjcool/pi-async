{
  "name": "pi-async",
  "version": "0.1.0",
  "description": "Pi extension for async shell tasks: background/delayed/sync modes, output-matching watches, event-driven waiting, settle guard for legion children, and a TUI task rail — completion notifications wake your session.",
  "type": "module",
  "license": "MIT",
  "author": "zzjcool",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zzjcool/pi-async.git"
  },
  "homepage": "https://github.com/zzjcool/pi-async#readme",
  "bugs": {
    "url": "https://github.com/zzjcool/pi-async/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "coding-agent",
    "async",
    "background-tasks",
    "task-manager",
    "shell",
    "watch",
    "delayed",
    "pi-legion"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "files": [
    "extensions/",
    "src/",
    "README.md",
    "LICENSE",
    "docs/CONTRACT.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "@earendil-works/pi-tui": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "^5.9.3"
  }
}
