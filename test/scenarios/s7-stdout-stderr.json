{
  "turns": [
    {
      "tools": [
        {
          "name": "async_run",
          "arguments": {
            "name": "revtest",
            "mode": "background",
            "command": "echo THIS_IS_ON_STDERR 1>&2 && sleep 60",
            "watch": {
              "intervalMs": 1000,
              "timeoutMs": 15000,
              "success_when": [
                {
                  "type": "stdout_contains",
                  "value": "THIS_IS_ON_STDERR"
                }
              ],
              "failure_when": [],
              "blind_checks": 3
            }
          }
        }
      ]
    },
    {
      "text": "Watching."
    },
    {
      "text": "ack"
    }
  ]
}